APP_ENV=development
APP_PORT=8080
APP_NAME=kueri-api

# Database (runtime + migrate Makefile)
DB_HOST=localhost
DB_PORT=5433
DB_USER=kueri
DB_PASSWORD=kueri_secret
DB_NAME=kueri
DB_SSLMODE=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Optional: used by `make migrate-up` / `migrate-down` when set
# DATABASE_URL=postgres://kueri:kueri_secret@localhost:5433/kueri?sslmode=disable

# Dev user for API routes (no auth yet)
DEV_USER_EMAIL=dev@kueri.local

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
